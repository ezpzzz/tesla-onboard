# ─────────────────────────────────────────────────────────────────────────────
# evhost.app — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in real values to enable live Tesla sign-in.
# Everything except NEXT_PUBLIC_* is server-only and never reaches the browser.

# Brand, contact, vehicle, and rental-policy settings are tenant data. Owners
# edit them during /owner/setup or at /owner/settings; they are persisted in
# the authenticated EVhost workspace and are not deployment environment vars.
# Existing ONLYEVS_* variable names remain stable deployment compatibility
# identifiers after the evhost.app product rename.

# --- Sign-in mode ------------------------------------------------------------
# "mock" → local-development consent screen + personas. No credentials.
# "live" → real Tesla Fleet API OAuth (authorization-code flow).
# Production fails safe to "live" if this build-time variable is omitted.
NEXT_PUBLIC_TESLA_AUTH_MODE=mock

# Enables the additive trip-access, telemetry, custom-domain, brand-media, and
# Google Calendar control plane. Keep false until the lifecycle migration,
# scoped worker, command proxy, and telemetry infrastructure have all passed
# the production gates in deploy/onlyevs/README.md.
NEXT_PUBLIC_ONLYEVS_OPERATIONS_ENABLED=false

# --- Live Tesla Fleet API OAuth (only needed when AUTH_MODE=live) ------------
# Register an application at https://developer.tesla.com to obtain these.
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=

# Must EXACTLY match a redirect URI registered in the Tesla developer portal,
# and must be reachable over HTTPS (Tesla rejects most http origins). For local
# dev, use a tunnel (ngrok / cloudflared) and register that HTTPS URL.
#   prod:  https://evhost.app/auth/tesla/callback
#   dev:   https://<your-tunnel>.ngrok-free.app/auth/tesla/callback
TESLA_REDIRECT_URI=https://evhost.app/auth/tesla/callback

# Second redirect URI for the owner-side "Connect with Tesla" in fleet setup
# (app/owner/setup). Redirect URIs are managed in the Tesla developer
# dashboard (https://developer.tesla.com), not by scripts/tesla-setup.mjs —
# that script's `register` command only POSTs your app domain for partner
# registration and cannot add or list redirect URIs. Add this owner callback
# URL in the dashboard alongside the guest one.
#   prod:  https://evhost.app/auth/owner/tesla/callback
#   dev:   https://<your-tunnel>.ngrok-free.app/auth/owner/tesla/callback
TESLA_OWNER_REDIRECT_URI=

# Guest-only scope: identity + vehicle list, with no persistent credential.
# The owner integration deliberately ignores this value and requests its
# reviewed persistent set: openid offline_access vehicle_device_data
# vehicle_cmds vehicle_location.
TESLA_SCOPES=openid vehicle_device_data

# Regional Fleet API base, used as the OAuth `audience` and for data calls.
# Region is auto-discovered at runtime via /api/1/users/region, so this is just
# the starting point. NA shown; EU = ...prd.eu... ; CN = ...prd.cn...tesla.cn
TESLA_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com

# Random 32+ char secret used to seal the session cookie (AES-256-GCM).
# Generate with:  openssl rand -hex 32
TESLA_SESSION_SECRET=

# --- Partner registration (optional) -----------------------------------------
# Only needed if Tesla requires partner-account registration / public-key
# hosting for your app. Generate keys with: node scripts/tesla-setup.mjs genkeys
# The public key is served at /.well-known/appspecific/com.tesla.3p.public-key.pem
# In serverless deploys, paste the PEM here (use \n for newlines) instead of the file.
# TESLA_PUBLIC_KEY_PEM=
# TESLA_APP_DOMAIN=your-app.vercel.app

# --- Owner dashboard sign-in (Supabase Auth) ---------------------------------
# Leaving these two unset keeps /owner open exactly as it is today (demo
# mode, no sign-in required). Values live in .env.local, never here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key used solely after owner authorization to retrieve
# reminder delivery material. Never expose this as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
# Public Google OAuth web client ID used by Google Identity Services on the
# EVhost origin. This is intentionally public; never put the client secret here.
NEXT_PUBLIC_GOOGLE_AUTH_CLIENT_ID=

# --- Durable integration security -------------------------------------------
# Comma-separated keyring, newest first: <version>:<base64-32-byte-key>.
# Encrypts workspace OAuth refresh tokens and short-lived invitation material.
ONLYEVS_DATA_ENCRYPTION_KEYS=
# Independent random 32+ byte secrets for sealed OAuth state and irreversible
# guest/Tesla-subject binding. Never expose either as NEXT_PUBLIC_*.
ONLYEVS_OAUTH_STATE_SECRET=
ONLYEVS_TRIP_BINDING_HMAC_SECRET=

# Server-side reminder delivery. Leave disabled until a verified SendGrid
# sender and controlled-mailbox canary have passed. The tenant support email,
# when valid, is used only as Reply-To.
EVHOST_REMINDERS_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=trips@evhost.app
SENDGRID_FROM_NAME=EVhost Trips

# --- Private Turo email intake ----------------------------------------------
# All switches stay false until the real-message go/no-go, Cloudflare Email
# Routing canary, R2 lifecycle verification, and SendGrid event-webhook canary
# in docs/spikes/2026-08-16-turo-email-ingestion-go-no-go.md are complete.
EVHOST_EMAIL_INGEST_ENABLED=false
ONLYEVS_EMAIL_WORKER_ENABLED=false
# Scoped direct-Postgres connection for the internal capture routes
# (app/api/internal/turo-email/{authorize,capture}) and the SendGrid
# delivery-event webhook (app/api/internal/sendgrid/events). These run in the
# public web deployment, where SUPABASE_SERVICE_ROLE_KEY is intentionally
# absent -- provision a LOGIN role through the Supabase pooler and grant it
# only the NOLOGIN `onlyevs_email_capture_svc` role (see
# supabase/migrations/20260816160000_onlyevs_email_capture_role.sql), the
# same shape as ONLYEVS_WORKER_DATABASE_URL below. If your pooler tier
# requires it, append `?uselibpqcompat=true` to the connection string
# yourself; the app code works whether or not it's present. Use `sslmode=
# disable` only for a local/test Postgres with no TLS listener.
ONLYEVS_EMAIL_CAPTURE_DATABASE_URL=
# Versioned 32-byte base64 keyrings, newest key first.
EVHOST_EMAIL_ALIAS_HMAC_KEYS=
EVHOST_EMAIL_CAPTURE_HMAC_KEYS=
EVHOST_EMAIL_KEK_KEYS=
# S3-compatible, private Cloudflare R2 access for the background worker.
EVHOST_EMAIL_R2_ENDPOINT=
EVHOST_EMAIL_R2_ACCESS_KEY_ID=
EVHOST_EMAIL_R2_SECRET_ACCESS_KEY=
EVHOST_EMAIL_R2_BUCKET=evhost-email-private
# SendGrid Event Webhook ECDSA public key(s). Outbound mail reuses SENDGRID_API_KEY.
# Versioned keyring, same rotation shape as the EVHOST_EMAIL_*_HMAC_KEYS above:
# "1:<pem-or-base64-der>,2:<pem-or-base64-der>". A single bare value (no "N:"
# prefix) is accepted as version 1 for backward compatibility. Renamed from the
# old singular EVHOST_SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY -- the code still reads
# the old singular name as a fallback when the plural one is unset, so update
# the hosting provider's env var to the plural name on your own schedule; the
# fallback is temporary and will be removed once that migration is confirmed.
EVHOST_SENDGRID_EVENT_WEBHOOK_PUBLIC_KEYS=
# Automation is independently gated by risk class and defaults fail-closed.
ONLYEVS_EMAIL_AUTO_CREATE_ENABLED=false
ONLYEVS_EMAIL_AUTO_PRETRIP_ENABLED=false
ONLYEVS_EMAIL_AUTO_ACTIVE_SAFE_ENABLED=false
ONLYEVS_EMAIL_AUTO_ACTIVE_DESTRUCTIVE_ENABLED=false
# Comma-separated parser template fingerprints approved from retained real
# Turo .eml fixtures. Empty means every candidate requires owner review.
EVHOST_TURO_APPROVED_TEMPLATE_FINGERPRINTS=

# Google Calendar OAuth for workspace trip-candidate import. A connected owner
# can run the initial import without the background operations service; periodic
# refresh begins only after that service is enabled. Calendar IDs and sync
# choices are tenant data; these platform credentials remain server-only.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://evhost.app/auth/owner/google/callback

# Custom-domain provider controller. Owners configure hostnames in Settings;
# the provider token/project identity are platform infrastructure and must not
# be tenant-editable or returned to a browser.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Scoped direct-Postgres connection used by the evhost.app background worker.
# Provision a LOGIN role and grant it only the NOLOGIN `onlyevs_worker` role.
ONLYEVS_WORKER_DATABASE_URL=
# Optional stable replica identity; a random process identity is safe by default.
ONLYEVS_WORKER_ID=

# Optional Kafka consumer for Tesla's official fleet-telemetry reference
# collector. Without brokers the worker still processes trips, domains, and
# Google Calendar refreshes but does not claim telemetry support.
ONLYEVS_KAFKA_BROKERS=
ONLYEVS_KAFKA_TLS=true
ONLYEVS_KAFKA_USERNAME=
ONLYEVS_KAFKA_PASSWORD=
ONLYEVS_KAFKA_VEHICLE_TOPIC=onlyevs_V
ONLYEVS_KAFKA_CONNECTIVITY_TOPIC=onlyevs_connectivity
# HTTPS endpoint for Tesla's official vehicle-command proxy plus the public
# fleet-telemetry destination validated with check_server_cert.sh.
ONLYEVS_TESLA_COMMAND_PROXY_URL=https://tesla-command-proxy.evhost.internal
ONLYEVS_TELEMETRY_HOSTNAME=telemetry.evhost.app
ONLYEVS_TELEMETRY_PORT=443
ONLYEVS_TELEMETRY_CA_PEM=
# Canonical HTTPS origin used as the secure authentication broker when guests
# enter through a workspace custom domain.
ONLYEVS_CANONICAL_ORIGIN=https://evhost.app
# Comma-separated platform/provider hosts that tenants may never claim.
ONLYEVS_RESERVED_HOSTNAMES=evhost.app,www.evhost.app,onlyevs-onboard.vercel.app
